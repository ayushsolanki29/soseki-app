NODE_ENV=development
PORT=5050

#Local Database
DATABASE_URL="postgresql://postgres:admin@localhost:5433/soseki_db"
DIRECT_URL=""

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10
UPLOAD_PATH=./uploads

# Client
CLIENT_URL="http://localhost:3000"
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MINUTES=15

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# AI model
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_FALLBACK_MODEL=cohere/north-mini-code:free
ENABLE_AI=true
AI_TIMEOUT=30000

AI_MAX_GENERATIONS_PER_DAY = 2
AI_MAX_PROMPT_LENGTH = 2000
AI_MAX_FIELDS = 6